{
  "version": "2",
  "plugins": [
    {
      "name": "rust-gen",
      "env": [
        "RUST_BACKTRACE",
        "RUST_LOG"
      ],
      "wasm": {
        "url": "file://./../../../target/wasm32-wasip1/release/sqlc-gen.wasm",
        "sha256": "11d89dc87e407b0f3cb0d1e36768017e27fe78fbdc43b33938aa49ff84d57a6c"
      }
    }
  ],
  "sql": [
    {
      "schema": "postgresql/schema.sql",
      "queries": "postgresql/query.sql",
      "engine": "postgresql",
      "codegen": [
        {
          "out": "postgresql",
          "plugin": "rust-gen",
          "options": {
            "use_async": true,
            "use_deadpool": false
          }
        }
      ]
    }
  ]
}
