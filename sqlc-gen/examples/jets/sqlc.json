{
  "version": "2",
  "plugins": [
    {
      "name": "rust-gen",
      "env": [
        "RUST_BACKTRACE",
        "RUST_LOG"
      ],
      "wasm": {
        "url": "file://./../../../target/wasm32-wasip1/release/sqlc-gen.wasm",
        "sha256": "2d6d5593f119d25bbf8e7e220c9edeac92b912c3cbf1fd92d0ac1c3a882f02c1"
      }
    }
  ],
  "sql": [
    {
      "schema": "postgresql/schema.sql",
      "queries": "postgresql/query-building.sql",
      "engine": "postgresql",
      "codegen": [
        {
          "out": "postgresql",
          "plugin": "rust-gen",
          "options": {
            "use_async": true,
            "use_deadpool": false
          }
        }
      ]
    }
  ]
}
